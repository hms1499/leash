node_modules/
.DS_Store
.env
.env.*
!.env.example

# Holds OPERATOR_PK in plaintext, the same way .env does, because that is the
# shape an agent runtime reads. The repo is public and check-secrets.sh would
# block it at commit time, but an ignored file cannot be staged by accident in
# the first place.
.mcp.json
# ...and any copy of it. A backup made before editing holds the same plaintext
# OPERATOR_PK, and `.mcp.json` alone does not cover `.mcp.json.bak`, which is
# exactly the name a careful person reaches for before changing the original.
.mcp.json.*
out/
cache/
broadcast/
.next/
.next-dev/
dist/
*.tsbuildinfo
next-env.d.ts
.superpowers/brainstorm/
test-results/
playwright-report/
.playwright-mcp/

# Agent tooling installed per-developer, not project source. The celo-builders
# skill says of itself that it is a snapshot and that the live copy at
# celobuilders.xyz/skill.md should be re-fetched each session, so a committed
# copy would go stale by design.
.agents/
skills-lock.json
# Written by `vercel link`. `.env*` came with it and was removed: this file is
# last-match-wins, and that pattern sits below `!.env.example` and re-ignores it.
.vercel
.env.local

# Finder duplicates. `.github/workflows/ci 2.yml` was a stale copy of ci.yml,
# and GitHub Actions globs every .yml in that directory -- committing it would
# have doubled CI on every pull request with the wrong config. The others were
# dead weight in app/ and mcp/. Ignored rather than merely deleted, because the
# way they appear is a copy-paste in a file manager, which will happen again.
* [0-9].*

# Local skill installs (symlinks into .agents/), not project files.
.claude/
skills/
